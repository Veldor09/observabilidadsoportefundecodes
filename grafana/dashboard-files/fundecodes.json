{
  "title": "Fundecodes Backend — Observabilidad",
  "uid": "fundecodes-main",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["fundecodes", "nodejs", "nestjs"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] },
          "unit": "reqps"
        }
      },
      "targets": [{ "expr": "sum(rate(http_requests_total{app=\"fundecodes-backend\"}[1m]))", "legendFormat": "req/s", "datasource": "Prometheus" }],
      "datasource": "Prometheus"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tasa de Errores HTTP",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.10 }] },
          "unit": "percentunit",
          "max": 1
        }
      },
      "targets": [{
        "expr": "sum(rate(http_errors_total{app=\"fundecodes-backend\"}[2m])) / sum(rate(http_requests_total{app=\"fundecodes-backend\"}[2m]))",
        "legendFormat": "error rate",
        "datasource": "Prometheus"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia p95",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] },
          "unit": "s"
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"fundecodes-backend\"}[5m])) by (le))",
        "legendFormat": "p95",
        "datasource": "Prometheus"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Peticiones HTTP por segundo (por código)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by(status_code) (rate(http_requests_total{app=\"fundecodes-backend\"}[1m]))",
          "legendFormat": "{{status_code}}",
          "datasource": "Prometheus"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia HTTP — p50, p95, p99",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{app=\"fundecodes-backend\"}[5m])) by (le))", "legendFormat": "p50", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"fundecodes-backend\"}[5m])) by (le))", "legendFormat": "p95", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{app=\"fundecodes-backend\"}[5m])) by (le))", "legendFormat": "p99", "datasource": "Prometheus" }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests Activos",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "http_active_requests{app=\"fundecodes-backend\"}", "legendFormat": "activos", "datasource": "Prometheus" }
      ],
      "datasource": "Prometheus"
    }
  ]
}
